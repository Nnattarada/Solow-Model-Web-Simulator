var as=$("aisum");if(base){var B2=calc(base);as.style.display="";as.textContent=m.sum.replace("{a0}",base.A.toFixed(3)).replace("{a1}",P.A.toFixed(3)).replace("{k}",pct(B2.K,R.K)).replace("{y}",pct(B2.Y,R.Y)).replace("{i}",pct(B2.I,R.I))}else{as.style.display="none"}
draw()}
function lang(x){L=x;document.documentElement.lang=x;var m=T[x];
document.querySelectorAll("[data-i]").forEach(function(e){e.textContent=m[e.getAttribute("data-i")]});
