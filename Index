var L="th",P={s:.34,d:.03,A:2.6},base=null,$=function(i){return document.getElementById(i)};
function calc(p){var r=p.s*p.A/p.d,K=r*r,Y=p.A*Math.sqrt(K);return{K:K,Y:Y,I:p.s*Y}}
function f3(n){return n.toLocaleString("en-US",{minimumFractionDigits:3,maximumFractionDigits:3})}
function pct(a,b){var v=(b/a-1)*100;return(v>=0?"+":"")+v.toFixed(2)+"%"}
function path(fn,sx,sy){var d="";for(var k=0;k<=2000;k+=20){d+=(k?"L":"M")+sx(k).toFixed(1)+" "+sy(fn(k)).toFixed(1)}return d}
function draw(){
var s=P.s,d=P.d,A=P.A,m=T[L],R=calc(P),W=720,H=400,l=62,r=18,t=18,b=52;
var Yf=function(k){return A*Math.sqrt(k)},If=function(k){return s*Yf(k)},Df=function(k){return d*k};
var ymax=Math.max(Yf(2000),Df(2000));if(base){ymax=Math.max(ymax,base.A*Math.sqrt(2000))}ymax*=1.06;
var step=Math.pow(10,Math.floor(Math.log10(ymax/5))),nn=ymax/5/step;step*=nn>5?10:nn>2?5:nn>1?2:1;ymax=Math.ceil(ymax/step)*step;
var sx=function(k){return l+k/2000*(W-l-r)},sy=function(v){return H-b-v/ymax*(H-t-b)};
var g="";for(var v=0;v<=ymax+1e-9;v+=step){g+='<line x1="'+l+'" x2="'+(W-r)+'" y1="'+sy(v)+'" y2="'+sy(v)+'" stroke="var(--line)"/><text x="'+(l-8)+'" y="'+(sy(v)+4)+'" text-anchor="end" font-size="12" fill="var(--mut)">'+(+v.toFixed(2))+'</text>'}
for(var k=0;k<=2000;k+=400){g+='<line y1="'+t+'" y2="'+(H-b)+'" x1="'+sx(k)+'" x2="'+sx(k)+'" stroke="var(--line)" stroke-dasharray="2 4"/><text x="'+sx(k)+'" y="'+(H-b+18)+'" text-anchor="middle" font-size="12" fill="var(--mut)">'+k.toLocaleString("en-US")+'</text>'}
g+='<text x="'+((l+W-r)/2)+'" y="'+(H-10)+'" text-anchor="middle" font-size="13" fill="var(--mut)">'+m.x+'</text>';
g+='<text transform="translate(16 '+((t+H-b)/2)+') rotate(-90)" text-anchor="middle" font-size="13" fill="var(--mut)">Y, I, D</text>';
g+='<defs><linearGradient id="gy" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="var(--y)" stop-opacity=".22"/><stop offset="1" stop-color="var(--y)" stop-opacity="0"/></linearGradient></defs>';
g+='<path d="'+path(Yf,sx,sy)+'L'+sx(2000)+' '+sy(0)+'L'+sx(0)+' '+sy(0)+'Z" fill="url(#gy)"/>';
if(base){var G=function(k){return base.A*Math.sqrt(k)};g+='<path d="'+path(G,sx,sy)+'" fill="none" stroke="var(--mut)" stroke-width="2" stroke-dasharray="6 5" opacity=".8"/>'}
g+='<path d="'+path(Yf,sx,sy)+'" fill="none" stroke="var(--y)" stroke-width="3.5" stroke-linecap="round"/>';
g+='<path d="'+path(If,sx,sy)+'" fill="none" stroke="var(--i)" stroke-width="3.5" stroke-linecap="round"/>';
g+='<path d="'+path(Df,sx,sy)+'" fill="none" stroke="var(--d)" stroke-width="3.5" stroke-linecap="round"/>';
if(R.K<=2000){var x=sx(R.K),y=sy(R.I);
g+='<line x1="'+x+'" x2="'+x+'" y1="'+y+'" y2="'+(H-b)+'" stroke="var(--gold)" stroke-width="2" stroke-dasharray="5 4"/><line x1="'+l+'" x2="'+x+'" y1="'+y+'" y2="'+y+'" stroke="var(--gold)" stroke-width="2" stroke-dasharray="5 4"/>';
g+='<circle cx="'+x+'" cy="'+y+'" r="13" fill="var(--gold)" opacity=".25"/><circle cx="'+x+'" cy="'+y+'" r="7" fill="var(--gold)" stroke="#fff" stroke-width="2.5"/>';
var tx=x>W-190?x-12:x+12,an=x>W-190?"end":"start";
g+='<text x="'+tx+'" y="'+(y-14)+'" text-anchor="'+an+'" font-size="13" font-weight="600" fill="var(--ink)">K* = '+f3(R.K)+'</text>';
g+='<text x="'+tx+'" y="'+(y+26)+'" text-anchor="'+an+'" font-size="12" fill="var(--mut)">I* = D* = '+f3(R.I)+'</text>'}
$("ch").innerHTML=g;$("note").textContent=R.K>2000?m.out:""}
function render(){
var R=calc(P);$("s").value=P.s;$("d").value=P.d;$("a").max=Math.max(5,P.A);$("a").value=P.A;
$("so").textContent=P.s.toFixed(2);$("do").textContent=P.d.toFixed(3);$("ao").textContent=P.A.toFixed(2);
$("rK").textContent=f3(R.K);$("rY").textContent=f3(R.Y);$("rI").textContent=f3(R.I);
var m=T[L],tb=$("tb");
if(!base){tb.innerHTML='<tr><td colspan="4" style="text-align:center;color:var(--mut)">'+m.empty+'</td></tr>'}
else{var B=calc(base),rows=[["K*",B.K,R.K],["Y*",B.Y,R.Y],["I* = D*",B.I,R.I]];
