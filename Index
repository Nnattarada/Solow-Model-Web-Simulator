$("bTH").className="pill"+(x=="th"?" on":"");$("bEN").className="pill"+(x=="en"?" on":"");render()}
$("s").oninput=function(){P.s=+this.value;render()};
$("d").oninput=function(){P.d=+this.value;render()};
$("a").oninput=function(){P.A=+this.value;render()};
$("pMine").onclick=function(){P={s:.34,d:.03,A:2.6};base=null;render()};
$("pSlide").onclick=function(){P={s:.3,d:.02,A:2.6};base=null;render()};
$("ai").onclick=function(){if(!base){base={s:P.s,d:P.d,A:P.A}}P={s:base.s,d:base.d,A:Math.round(base.A*1.2*1e4)/1e4};render()};
$("rs").onclick=function(){if(base){P={s:base.s,d:base.d,A:base.A};base=null}render()};
$("bTH").onclick=function(){lang("th")};$("bEN").onclick=function(){lang("en")};
$("theme").onclick=function(){var e=document.documentElement,dark=e.getAttribute("data-theme")?e.getAttribute("data-theme")=="dark":matchMedia("(prefers-color-scheme:dark)").matches;e.setAttribute("data-theme",dark?"light":"dark")};
lang("th");
</script>
